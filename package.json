{
  "name": "model-xray",
  "version": "0.2.0",
  "description": "X-ray your LLM endpoints. Audit OpenAI-compatible relays for fake or watered-down models.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenLlamas/model-xray.git"
  },
  "bin": {
    "model-xray": "./dist/src/cli.js"
  },
  "files": [
    "dist/src"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "llm",
    "openai",
    "audit",
    "relay",
    "proxy",
    "cli"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "npm run build && npm run test:only",
    "test:only": "node --test dist/test/*.test.js dist/test/unit/*.test.js",
    "web": "node scripts/web-server.mjs",
    "ui": "node scripts/serve.mjs",
    "ask": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-test.ps1",
    "verify:sse": "npm run build && node --test dist/test/unit/sse.test.js",
    "verify:usage": "npm run build && node --test dist/test/unit/sse.test.js",
    "verify:ledger": "npm run build && node --test dist/test/unit/ledger.test.js",
    "verify:crash": "npm run build && node --test dist/test/unit/ledger-crash.test.js",
    "verify:leak": "npm run build && node --test dist/test/unit/gateway.test.js",
    "verify:ttft": "npm run build && node --test dist/test/unit/gateway.test.js",
    "verify:tz": "npm run build && node --test dist/test/unit/gateway.test.js",
    "verify:looplag": "npm run build && node --test dist/test/unit/gateway.test.js",
    "verify:alerts": "npm run build && node --test dist/test/unit/gateway.test.js",
    "verify:degraded": "npm run build && node --test dist/test/unit/gateway.test.js",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.7.0"
  }
}
